# Local YouTube Music recommender settings.
#
# Copy this file to your process manager's environment configuration.  Do not
# put browser cookies, OAuth tokens, API keys, or ytmusicapi header contents in
# this file.  The loader reads environment variables only; it does not
# automatically load a .env file.
#
# Relative paths are resolved by the process working directory.  The
# unprefixed aliases DATABASE_PATH, HOST, PORT, and so on are also accepted,
# but the prefixed names avoid collisions with unrelated services.

YTMUSIC_RECOMMENDER_DATABASE_PATH=data/ytmusic_recommender.sqlite3
YTMUSIC_RECOMMENDER_HOST=127.0.0.1
YTMUSIC_RECOMMENDER_PORT=8000
YTMUSIC_RECOMMENDER_YOUTUBE_MUSIC_HISTORY_URL=https://music.youtube.com/history

# Optional: a local Chrome DevTools Protocol endpoint.  Leave blank unless a
# connected browser has explicitly enabled remote debugging.
YTMUSIC_RECOMMENDER_CHROME_CDP_URL=

# Optional: path to a local ytmusicapi headers file.  The file must already
# exist when this setting is provided; never paste its contents here.
YTMUSIC_RECOMMENDER_YTMUSICAPI_HEADERS_PATH=

YTMUSIC_RECOMMENDER_SCAN_LIMIT=1000
YTMUSIC_RECOMMENDER_RECOMMENDATION_LIMIT=50
YTMUSIC_RECOMMENDER_SCHEDULER_INTERVAL_SECONDS=3600

# Optional browser-bridge protection.  Leave blank unless the local extension
# and API are configured to share this token through a secret environment
# mechanism; never commit a real token here.
YTMUSIC_RECOMMENDER_BROWSER_BRIDGE_TOKEN=

# Keep cross-origin access local by default.  Use a comma-separated list of
# explicit origins if a separately served local UI needs access.
YTMUSIC_RECOMMENDER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
YTMUSIC_RECOMMENDER_LOG_LEVEL=INFO

# Playlist writes are dry-run/disabled by default.  Set true only after an
# actual browser/API capability check and an explicit user decision.
YTMUSIC_RECOMMENDER_ENABLE_PLAYLIST_WRITES=false
